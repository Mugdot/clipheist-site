# Copy this file to .env and fill it in.
# Stripe secret key from https://dashboard.stripe.com/apikeys (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). In Stripe: Developers > Webhooks > add endpoint
#   URL: https://YOUR-SITE/stripe/webhook   Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Email sending, option 1: https://brevo.com (free, no domain needed: verify one sender address)
BREVO_API_KEY=
# Email sending, option 2: https://resend.com (free tier is enough to start). Verify your domain there first.
RESEND_API_KEY=
EMAIL_FROM=ClipHeist <downloads@yourdomain.com>
# Any long random string (keeps download links unforgeable)
DOWNLOAD_SECRET=
# Public address of the site once deployed, e.g. https://clipheist.app
BASE_URL=http://localhost:3000
PORT=3000
INSTALLER_PATH=downloads/ClipHeist-Setup.exe
# Signs app activations. Created for you by: node scripts/make-license-keys.js  (never share it)
LICENSE_PRIVATE_KEY=
# How many PCs one licence key can activate
MAX_DEVICES=2
# Optional: if the installer is hosted elsewhere (it is too big for GitHub repos), put its https link here
INSTALLER_URL=
